# Choose openai or openrouter as the service default.
LLM_PROVIDER=openai

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Persistent browser sessions (separate from Eye notifications and Celery queues).
BROWSER_REDIS_URL=redis://127.0.0.1:6379/3
BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
BROWSER_USER_DATA_DIR=D:\BroserUse\User Data
BROWSER_PROFILE_DIRECTORY=Profile 1
# Optional location for isolated session profiles; defaults to browseragent/.sessions.
# BROWSER_SESSION_DATA_DIR=D:\BroserUse\Sessions
BROWSER_MAX_SESSIONS=8
BROWSER_MAX_QUEUE=100
