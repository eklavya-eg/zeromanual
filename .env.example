# ZeroManual - Root Environment Configuration
# This file contains common/shared keys used across multiple projects.
# Copy this to .env and fill in your values.
# Project-specific .env files can override these values.

# =============================================================================
# SHARED LLM CONFIGURATION (used by browseragent, workers, workflows)
# =============================================================================
# Choose openai or openrouter as the service default.
LLM_PROVIDER=openrouter

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# SHARED INFRASTRUCTURE (used by eye, workers, workflows, browseragent)
# =============================================================================
# PostgreSQL
DATABASE_URL=postgresql://eye:eye-local-password@127.0.0.1:5432/eye?schema=public
POSTGRES_DB=eye
POSTGRES_USER=eye
POSTGRES_PASSWORD=eye-local-password
POSTGRES_PORT=5432

# Redis - logical databases:
# 0 = Eye notifications, 1 = Celery broker, 2 = Celery results, 3 = Browser Agent sessions
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
BROWSER_REDIS_URL=redis://127.0.0.1:6379/3
REDIS_PORT=6379

# =============================================================================
# SHARED SERVICE URLS (used by workers, workflows, eye)
# =============================================================================
EYE_BASE_URL=http://127.0.0.1:8000
BROWSER_AGENT_URL=http://127.0.0.1:8001/invoke

# =============================================================================
# SHARED WORKER CONFIGURATION (used by workers, workflows)
# =============================================================================
WORKER_NAME=job-application-worker
WORKER_QUEUE=job-applications

# =============================================================================
# SHARED BROWSER CONFIGURATION (used by browseragent, workers)
# =============================================================================
BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
BROWSER_USER_DATA_DIR=D:\BrowserUse\User Data
BROWSER_PROFILE_DIRECTORY=Profile 1
# Optional location for isolated session profiles; defaults to browseragent/.sessions
# BROWSER_SESSION_DATA_DIR=D:\BrowserUse\Sessions
BROWSER_MAX_SESSIONS=8
BROWSER_MAX_QUEUE=100

# Playwright chromium executable (used by workers)
PLAYWRIGHT_CHROMIUM_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe

# =============================================================================
# EYE-SPECIFIC (only used by eye service)
# =============================================================================
# Scheduler
SCHEDULER_REGISTER_WINDOWS_TASKS=true
SCHEDULER_POLL_SECONDS=30

# CORS origins for dashboard
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sub-agent settings
SUB_AGENT_JOB_TTL_SECONDS=86400
SUB_AGENT_NOTIFICATION_LIMIT=100

# Commands - enable only on trusted deployment
EYE_ENABLE_COMMAND_STEPS=false
# Set a strong private value; required as X-Eye-Command-Token to create/update command workflows
EYE_COMMAND_ADMIN_TOKEN=

# =============================================================================
# DASHBOARD-SPECIFIC (only used by Next.js dashboard)
# =============================================================================
# Same-origin path used through Nginx
NEXT_PUBLIC_EYE_API_URL=/api

# For direct local development without Nginx, use:
# NEXT_PUBLIC_EYE_API_URL=http://127.0.0.1:8000/api
# NEXT_PUBLIC_EYE_WS_URL=ws://127.0.0.1:8000/api/notifications/ws

# =============================================================================
# WORKERS-SPECIFIC (only used by workers)
# =============================================================================
WORKER_OUTPUT_DIR=output
PROFILE_DATA_PATH=static/profile.yaml
RESUME_DATA_PATH=static/resume.json