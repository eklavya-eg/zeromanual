generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SubAgent {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @unique @db.VarChar(120)
  description    String         @default("") @db.Text
  invoke_url     String         @db.VarChar(2048)
  enabled        Boolean        @default(true)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  modified_at    DateTime       @updatedAt @db.Timestamptz(6)
  workflow_steps WorkflowStep[]

  @@map("sub_agents")
}

model Workflow {
  id               String         @id @default(uuid()) @db.Uuid
  name             String         @db.VarChar(160)
  description      String         @default("") @db.Text
  total_sub_agents Int
  enabled          Boolean        @default(true)
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  modified_at      DateTime       @updatedAt @db.Timestamptz(6)
  steps            WorkflowStep[]
  schedules        Schedule[]
  runs             WorkflowRun[]

  @@index([name])
  @@map("workflows")
}

enum WorkflowStepType {
  sub_agent
  command
}

model WorkflowStep {
  id                String           @id @default(uuid()) @db.Uuid
  workflow_id       String           @db.Uuid
  step_type         WorkflowStepType @default(sub_agent)
  sub_agent_id      String?          @db.Uuid
  command           String?          @db.Text
  working_directory String?          @db.Text
  timeout_seconds   Int              @default(300)
  position          Int
  payload           Json
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  workflow          Workflow         @relation(fields: [workflow_id], references: [id], onDelete: Cascade)
  sub_agent         SubAgent?        @relation(fields: [sub_agent_id], references: [id])
  step_runs    StepRun[]

  @@unique([workflow_id, position])
  @@index([workflow_id])
  @@index([sub_agent_id])
  @@map("workflow_steps")
}

model Schedule {
  id                      String        @id @default(uuid()) @db.Uuid
  workflow_id             String        @db.Uuid
  schedule_type           String        @db.VarChar(16)
  recurrence              String        @db.VarChar(16)
  time_of_day             String?       @db.VarChar(5)
  range_start             String?       @db.VarChar(5)
  range_end               String?       @db.VarChar(5)
  day_of_month            Int?
  month                   Int?
  run_if_missed           Boolean       @default(true)
  misfire_grace_minutes   Int           @default(1440)
  enabled                 Boolean       @default(true)
  windows_task_name       String?       @db.VarChar(240)
  registration_error      String?       @db.Text
  created_at              DateTime      @default(now()) @db.Timestamptz(6)
  modified_at             DateTime      @updatedAt @db.Timestamptz(6)
  workflow                Workflow      @relation(fields: [workflow_id], references: [id], onDelete: Cascade)
  runs                    WorkflowRun[]

  @@index([workflow_id])
  @@map("schedules")
}

model WorkflowRun {
  id             String     @id @default(uuid()) @db.Uuid
  workflow_id    String     @db.Uuid
  schedule_id    String?    @db.Uuid
  occurrence_key String?    @db.VarChar(80)
  status         String     @db.VarChar(20)
  attempt_count  Int        @default(1)
  scheduled_for  DateTime?  @db.Timestamptz(6)
  started_at     DateTime   @default(now()) @db.Timestamptz(6)
  finished_at    DateTime?  @db.Timestamptz(6)
  error          String?    @db.Text
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  workflow       Workflow   @relation(fields: [workflow_id], references: [id])
  schedule       Schedule?  @relation(fields: [schedule_id], references: [id], onDelete: SetNull)
  step_runs      StepRun[]

  @@unique([schedule_id, occurrence_key])
  @@index([workflow_id])
  @@index([schedule_id])
  @@index([status])
  @@map("workflow_runs")
}

model StepRun {
  id                String       @id @default(uuid()) @db.Uuid
  workflow_run_id   String       @db.Uuid
  workflow_step_id  String       @db.Uuid
  attempt_number    Int
  status            String       @db.VarChar(20)
  response           Json?
  error              String?      @db.Text
  started_at         DateTime     @default(now()) @db.Timestamptz(6)
  finished_at        DateTime?    @db.Timestamptz(6)
  workflow_run       WorkflowRun  @relation(fields: [workflow_run_id], references: [id], onDelete: Cascade)
  workflow_step      WorkflowStep @relation(fields: [workflow_step_id], references: [id])

  @@index([workflow_run_id])
  @@map("step_runs")
}

model Worker {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @unique @db.VarChar(160)
  enabled     Boolean         @default(true)
  created_at  DateTime        @default(now()) @db.Timestamptz(6)
  modified_at DateTime        @updatedAt @db.Timestamptz(6)
  task_runs   WorkerTaskRun[]
  logs        WorkerLog[]

  @@map("workers")
}

model WorkerTaskRun {
  id             String      @id @default(uuid()) @db.Uuid
  worker_id      String      @db.Uuid
  celery_task_id String      @unique @db.VarChar(160)
  job_url        String      @db.VarChar(2048)
  company_name   String      @default("NA") @db.VarChar(500)
  job_title      String      @default("NA") @db.VarChar(500)
  package        String      @default("NA") @db.VarChar(500)
  platform       String      @default("NA") @db.VarChar(160)
  payload        Json
  result         Json?
  status         String      @db.VarChar(20)
  started        Boolean     @default(true)
  success        Boolean     @default(false)
  failed         Boolean     @default(false)
  step_failed    String?     @db.VarChar(120)
  error          String?     @db.Text
  started_at     DateTime    @default(now()) @db.Timestamptz(6)
  finished_at    DateTime?   @db.Timestamptz(6)
  worker         Worker      @relation(fields: [worker_id], references: [id])
  logs           WorkerLog[]
  application    JobApplication?
  skip           WorkerSkip?

  @@index([worker_id])
  @@index([status])
  @@index([started_at])
  @@map("worker_task_runs")
}

model JobApplication {
  job_url      String         @id @db.VarChar(2048)
  company_name String         @default("NA") @db.VarChar(500)
  job_title    String         @default("NA") @db.VarChar(500)
  package      String         @default("NA") @db.VarChar(500)
  platform     String         @default("NA") @db.VarChar(160)
  first_run_id String?        @unique @db.Uuid
  status       String         @default("running") @db.VarChar(20)
  reason       String?        @db.Text
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  modified_at  DateTime       @updatedAt @db.Timestamptz(6)
  first_run    WorkerTaskRun? @relation(fields: [first_run_id], references: [id], onDelete: SetNull)

  @@map("job_applications")
}

model WorkerSkip {
  id          String        @id @default(uuid()) @db.Uuid
  task_run_id String        @unique @db.Uuid
  job_url     String        @db.VarChar(2048)
  reason      String        @db.VarChar(30)
  details     String        @db.Text
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  task_run    WorkerTaskRun @relation(fields: [task_run_id], references: [id], onDelete: Cascade)

  @@index([job_url])
  @@index([reason])
  @@map("worker_skips")
}

model WorkerLog {
  id          String        @id @default(uuid()) @db.Uuid
  worker_id   String        @db.Uuid
  task_run_id String        @db.Uuid
  level       String        @db.VarChar(20)
  step        String        @db.VarChar(120)
  message     String        @db.Text
  details     Json?
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  worker      Worker        @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  task_run    WorkerTaskRun @relation(fields: [task_run_id], references: [id], onDelete: Cascade)

  @@index([worker_id])
  @@index([task_run_id])
  @@index([created_at])
  @@map("worker_logs")
}
