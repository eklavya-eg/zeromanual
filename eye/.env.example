DATABASE_URL=postgresql://eye:eye-local-password@localhost:5432/eye?schema=public
EYE_BASE_URL=http://127.0.0.1:8000
# Legacy compatibility: SWITCH_BASE_URL is also accepted.
SCHEDULER_REGISTER_WINDOWS_TASKS=true
SCHEDULER_POLL_SECONDS=30
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REDIS_URL=redis://127.0.0.1:6379/0
SUB_AGENT_JOB_TTL_SECONDS=86400
SUB_AGENT_NOTIFICATION_LIMIT=100

POSTGRES_DB=eye
POSTGRES_USER=eye
POSTGRES_PASSWORD=eye-local-password
POSTGRES_PORT=5432
REDIS_PORT=6379

# Commands run with the Eye service account's permissions. Enable only on a trusted deployment.
EYE_ENABLE_COMMAND_STEPS=false
# Set a strong private value; required as X-Eye-Command-Token to create/update command workflows.
EYE_COMMAND_ADMIN_TOKEN=
